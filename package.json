{
  "name": "clojure-script-org",
  "version": "0.1.0",
  "description": "ClojureScript beginners home page built with Calcit",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "watch": "calcit -w js",
    "serve": "vite --host 127.0.0.1",
    "check": "calcit --check-only --all-defs",
    "build": "calcit js && vite build --base=./"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:clojure-china/clojure-script.org.git"
  },
  "author": "jiyinyiyong",
  "license": "MIT",
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@calcit/procs": "0.30.1",
    "@calcit/std": "^0.0.2",
    "cirru-color": "^0.2.4",
    "copy-text-to-clipboard": "^3.2.2",
    "dayjs": "^1.11.13",
    "escape-html": "^1.0.3",
    "highlight.js": "^11.8.0"
  }
}
